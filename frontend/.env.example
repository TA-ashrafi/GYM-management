# =================================================================
# ALPHA FITNESS — FRONTEND ENVIRONMENT VARIABLES
# Copy this file to .env inside the frontend/ directory
# =================================================================

# 1. Your Supabase Project URL (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase Anonymous Key (From Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here
